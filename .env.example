# Copy this file to .env.local and fill in your values

# =============================
# Admin Panel
# =============================
ADMIN_PASSWORD=your-secure-password-here

# =============================
# Storage (REQUIRED for Vercel — pick ONE)
# =============================
# Option 1: GitHub API (changes commit to repo, triggers Vercel redeploy)
# GITHUB_TOKEN=ghp_your_github_personal_access_token
# GITHUB_REPO=RilangumaIshaku/portfolio
# GITHUB_BRANCH=main

# Option 2: Upstash Redis / Vercel KV (instant persistence)
# KV_REST_API_URL=https://your-kv-store.upstash.io
# KV_REST_API_TOKEN=your_kv_token

# =============================
# Image Storage (REQUIRED for Vercel image uploads — pick ONE)
# =============================
# Option 1: Vercel Blob (run: npx vercel blob store create)
# BLOB_READ_WRITE_TOKEN=your_blob_token

# Option 2: imgbb (free — sign up at https://api.imgbb.com/)
# IMGBB_API_KEY=your_imgbb_api_key

# =============================
# Contact Emails (REQUIRED for contact form to send emails)
# =============================
# Sign up at https://resend.com → verify your domain → get API key
RESEND_API_KEY=re_your_api_key_here
# Only needed if using a custom domain (not required on free tier with onboarding@resend.dev)
# RESEND_FROM_EMAIL=Portfolio <noreply@yourdomain.com>

# Where inquiries are sent
CONTACT_EMAIL=davidishaku560@gmail.com

# =============================
# Site URL (for SEO metadata)
# =============================
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
